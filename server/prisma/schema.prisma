// Modelo de dados da Kultiva
// Relacionamentos 1:N: Usuario (produtor) -> Propriedade -> Oferta; Usuario (varejista) -> Pedido / Demanda
// Relacionamento N:N: Pedido <-> Oferta pela tabela ItemPedido (quantidade e preço negociado)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  PRODUTOR
  VAREJISTA
  ADMIN
}

enum StatusOferta {
  ATIVA
  PAUSADA
  RASCUNHO
  ESGOTADA
}

enum StatusPedido {
  PENDENTE
  ACEITO
  RECUSADO
  CANCELADO
  ENTREGUE
}

enum StatusDemanda {
  ABERTA
  ENCERRADA
}

enum TipoNotificacao {
  DEMANDA
  PEDIDO
  MENSAGEM
  PRECO
  SISTEMA
}

model Usuario {
  id                  Int      @id @default(autoincrement())
  nome                String
  email               String   @unique
  senhaHash           String
  perfil              Perfil
  telefone            String?
  documento           String?
  organizacao         String? // nome do sítio ou razão social
  tipoEstabelecimento String? // Supermercado, Restaurante, Mercado...
  cep                 String?
  endereco            String?
  cidade              String?
  uf                  String?
  latitude            Float?
  longitude           Float?
  raioKm              Int      @default(30)
  plano               String   @default("Gratuito")
  bloqueado           Boolean  @default(false)
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  propriedades       Propriedade[]
  pedidosFeitos      Pedido[]      @relation("PedidosVarejista")
  pedidosRecebidos   Pedido[]      @relation("PedidosProdutor")
  demandas           Demanda[]
  notificacoes       Notificacao[]
  favoritos          Favorito[]
  mensagensEnviadas  Mensagem[]    @relation("MensagensEnviadas")
  mensagensRecebidas Mensagem[]    @relation("MensagensRecebidas")

  @@index([perfil])
}

model Propriedade {
  id            Int      @id @default(autoincrement())
  nome          String
  cep           String
  endereco      String?
  cidade        String
  uf            String
  latitude      Float
  longitude     Float
  areaHa        Float?
  raioEntregaKm Int      @default(30)
  produtorId    Int
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  produtor Usuario  @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  ofertas  Oferta[]

  @@index([produtorId])
}

model Produto {
  id            Int    @id @default(autoincrement())
  nome          String @unique
  foto          String @default("outro") // foto usada no front: alface, tomate, morango, couve, cenoura, banana ou outro
  criadoPorId   Int? // produtor que cadastrou o produto (null = catálogo da Kultiva)
  categoria     String // Hortaliças, Frutas, Legumes, Grãos
  unidadePadrao String

  ofertas  Oferta[]
  demandas Demanda[]
}

model Oferta {
  id                   Int          @id @default(autoincrement())
  propriedadeId        Int
  produtoId            Int
  variedade            String?
  descricao            String?
  preco                Decimal      @db.Decimal(10, 2)
  unidade              String
  quantidadeTotal      Int
  quantidadeDisponivel Int
  pedidoMinimo         Int          @default(1)
  dataColheita         DateTime
  disponivelAte        DateTime?
  organico             Boolean      @default(false)
  entregaInclusa       Boolean      @default(false)
  status               StatusOferta @default(ATIVA)
  visualizacoes        Int          @default(0)
  criadoEm             DateTime     @default(now())
  atualizadoEm         DateTime     @updatedAt

  propriedade Propriedade  @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  produto     Produto      @relation(fields: [produtoId], references: [id])
  itens       ItemPedido[]
  favoritos   Favorito[]
  mensagens   Mensagem[]

  @@index([produtoId])
  @@index([status])
}

model Pedido {
  id           Int          @id @default(autoincrement())
  varejistaId  Int
  produtorId   Int
  status       StatusPedido @default(PENDENTE)
  total        Decimal      @db.Decimal(12, 2)
  dataEntrega  DateTime?
  observacao   String?
  motivo       String? // motivo da recusa ou do cancelamento
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  aceitoEm     DateTime?
  entregueEm   DateTime?

  varejista Usuario      @relation("PedidosVarejista", fields: [varejistaId], references: [id])
  produtor  Usuario      @relation("PedidosProdutor", fields: [produtorId], references: [id])
  itens     ItemPedido[]

  @@index([varejistaId, status])
  @@index([produtorId, status])
}

// Tabela associativa N:N entre Pedido e Oferta
model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int
  ofertaId      Int
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  oferta Oferta @relation(fields: [ofertaId], references: [id])

  @@unique([pedidoId, ofertaId])
}

model Demanda {
  id           Int           @id @default(autoincrement())
  varejistaId  Int
  produtoId    Int
  quantidade   Int
  unidade      String
  precoMaximo  Decimal?      @db.Decimal(10, 2)
  prazo        DateTime
  frequencia   String        @default("Compra única")
  raioKm       Int           @default(30)
  observacoes  String?
  status       StatusDemanda @default(ABERTA)
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  varejista Usuario @relation(fields: [varejistaId], references: [id], onDelete: Cascade)
  produto   Produto @relation(fields: [produtoId], references: [id])

  @@index([status, produtoId])
}

model Notificacao {
  id        Int             @id @default(autoincrement())
  usuarioId Int
  tipo      TipoNotificacao
  titulo    String
  texto     String
  link      String?
  lida      Boolean         @default(false)
  criadoEm  DateTime        @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, lida])
}

// Favoritos do varejista (N:N Usuario <-> Oferta)
model Favorito {
  varejistaId Int
  ofertaId    Int
  criadoEm    DateTime @default(now())

  varejista Usuario @relation(fields: [varejistaId], references: [id], onDelete: Cascade)
  oferta    Oferta  @relation(fields: [ofertaId], references: [id], onDelete: Cascade)

  @@id([varejistaId, ofertaId])
}

// Chat de negociação entre produtor e varejista (a conversa é o par de usuários)
model Mensagem {
  id             Int      @id @default(autoincrement())
  remetenteId    Int
  destinatarioId Int
  ofertaId       Int? // oferta sendo negociada, quando a conversa começa por um produto
  texto          String
  lida           Boolean  @default(false)
  criadoEm       DateTime @default(now())

  remetente    Usuario @relation("MensagensEnviadas", fields: [remetenteId], references: [id], onDelete: Cascade)
  destinatario Usuario @relation("MensagensRecebidas", fields: [destinatarioId], references: [id], onDelete: Cascade)
  oferta       Oferta? @relation(fields: [ofertaId], references: [id], onDelete: SetNull)

  @@index([remetenteId, destinatarioId, criadoEm])
  @@index([destinatarioId, lida])
}
