# Banco PostgreSQL. Local: npm run db:local (porta 5433). Produção: string de conexão do Neon.
DATABASE_URL="postgresql://kultiva:kultiva@localhost:5433/kultiva?schema=public"

# Segredo do JWT: troque por um valor longo e aleatório (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES_IN="8h"

PORT=3333
# Origens liberadas no CORS, separadas por vírgula (em produção: a URL da Vercel)
CORS_ORIGIN="http://localhost:5173"
